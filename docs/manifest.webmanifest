{
  "name": "Nijatva",
  "short_name": "Nijatva",
  "description": "A privacy-first Android browser. This is its web side: the landing page, the extension store, and a window you can try.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Extension store", "url": "https://vasudev-work.github.io/nijatva-web-store/" },
    { "name": "Download the app", "url": "./#download" }
  ]
}
